{
    "name": "@portable-agent/widget-sdk",
    "version": "0.2.0",
    "description": "Проверка карточек Portable Agent для Web и мессенджеров",
    "type": "module",
    "license": "Apache-2.0",
    "packageManager": "pnpm@11.19.0",
    "engines": {
        "node": ">=24"
    },
    "files": [
        "dist",
        "contracts",
        "README.md",
        "LICENSE"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "generate": "json2ts -i contracts/action-confirmation.schema.json -o src/generated/action-confirmation.ts && json2ts -i contracts/connection-widget.schema.json -o src/generated/connection-widget.ts && prettier --write src/generated/*.ts",
        "clean": "node scripts/clean.mjs",
        "check:generated": "pnpm generate && git diff --exit-code -- src/generated",
        "lint": "pnpm check:generated && eslint . && prettier --check .",
        "format": "prettier --write .",
        "test": "pnpm generate && vitest run --coverage",
        "typecheck": "pnpm generate && tsc --noEmit -p tsconfig.test.json",
        "build": "pnpm clean && pnpm generate && tsc -p tsconfig.json",
        "pack:check": "pnpm build && pnpm pack --pack-destination .pack",
        "prepack": "pnpm build"
    },
    "dependencies": {
        "ajv": "8.20.0",
        "ajv-formats": "3.0.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.6.3",
        "@vitest/coverage-v8": "5.0.3",
        "eslint": "10.11.0",
        "json-schema-to-typescript": "16.0.0",
        "prettier": "3.9.9",
        "typescript": "7.0.2",
        "typescript-eslint": "8.71.0",
        "vitest": "5.0.3"
    }
}
